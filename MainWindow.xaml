<Window x:Class="Ming_AutoClicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Ming_AutoClicker.Views"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:helpers="clr-namespace:Ming_AutoClicker.Helpers"
        Title="{DynamicResource AppTitle}"
        Icon="Assets/favicon.ico"
        Style="{StaticResource PixelWindow}"
        Width="820" Height="620" MinWidth="680" MinHeight="520"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
    <Window.Resources>
        <Style x:Key="NavigationTabItem" TargetType="TabItem" BasedOn="{StaticResource ModernTabItem}">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsNavigationEnabled}" Value="False"/>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="IsEnabled" Value="False"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="16,14,16,0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="2" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="10" Height="10" Background="{StaticResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="SYSTEM // AUTOMATION DECK" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="ONLINE" Foreground="{StaticResource SuccessBrush}" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" x:Name="MainTabControl"
                    Style="{StaticResource ModernTabControl}"
                    SelectedIndex="{Binding CurrentTabIndex, Mode=TwoWay}"
                    Margin="16,12,16,12">
            <TabItem Style="{StaticResource NavigationTabItem}" Header="{DynamicResource MainAutoClickTab}" helpers:PixelIcon.Kind="{x:Static iconPacks:PackIconPixelartIconsKind.Mouse}">
                <views:AutoClickView x:Name="AutoClickView"/>
            </TabItem>
            <TabItem Style="{StaticResource NavigationTabItem}" Header="{DynamicResource MainMacroTab}" helpers:PixelIcon.Kind="{x:Static iconPacks:PackIconPixelartIconsKind.Clipboard}">
                <views:MacroListView x:Name="MacroListView"/>
            </TabItem>
            <TabItem Style="{StaticResource NavigationTabItem}" Header="{DynamicResource MainRecordingTab}" helpers:PixelIcon.Kind="{x:Static iconPacks:PackIconPixelartIconsKind.RadioOn}">
                <views:RecordingPage x:Name="RecordingPage"/>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="{StaticResource StatusBarBrush}"
                BorderThickness="0,2,0,0" BorderBrush="{StaticResource BorderBrush}" Padding="16,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                    <Rectangle x:Name="StatusIndicator" Width="8" Height="8" Fill="{StaticResource TextDisabledBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding ExecutionStatus}" Style="{StaticResource StatusText}"/>
                </StackPanel>
                <Border Grid.Column="1" Width="2" Background="{StaticResource BorderBrush}" Margin="0,0,14,0"/>
                <TextBlock Grid.Column="2" Text="{Binding StatusMessage}" Style="{StaticResource StatusText}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CurrentTabIndex}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
                    </StackPanel.Style>
                    <TextBlock Foreground="{StaticResource PrimaryBrush}" FontFamily="{StaticResource PixelMonoFontFamily}" FontSize="11">
                        <Run Text="{DynamicResource MainClickCountPrefix}"/><Run Text="{Binding AutoClickCount}"/><Run Text="{DynamicResource MainClickCountSuffix}"/>
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="4" Content="{DynamicResource MainSettingsButton}"
                        helpers:PixelIcon.Kind="{x:Static iconPacks:PackIconPixelartIconsKind.Sliders2}"
                        Style="{StaticResource SmallButton}" ToolTip="{DynamicResource MainSettingsTooltip}"
                        IsEnabled="{Binding CanConfigureSettings}" Click="OnSettingsButtonClick"/>
                <TextBlock Grid.Column="5" x:Name="VersionText" FontFamily="{StaticResource PixelMonoFontFamily}" FontSize="10"
                           Foreground="{StaticResource TextDisabledBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    xmlns:helpers="clr-namespace:Ming_AutoClicker.Helpers"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <Style x:Key="PixelWindow" TargetType="Window">
        <Setter Property="WindowStyle" Value="None"/>
        <Setter Property="AllowsTransparency" Value="False"/>
        <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource PixelFontFamily}"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="shell:WindowChrome.WindowChrome">
            <Setter.Value>
                <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="6"
                                    GlassFrameThickness="0" CornerRadius="0"
                                    UseAeroCaptionButtons="False"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <Border BorderBrush="{StaticResource PrimaryDarkBrush}" BorderThickness="2"
                            Background="{TemplateBinding Background}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{StaticResource PanelHeaderBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="8" Height="8" Margin="13,0,10,0"
                                            Background="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{TemplateBinding Title}"
                                               Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                        <Button helpers:PixelIcon.Kind="{x:Static iconPacks:PackIconPixelartIconsKind.Minus}"
                                                ToolTip="最小化"
                                                Command="{x:Static helpers:WindowCommands.Minimize}"
                                                CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource WindowCaptionButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ResizeMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="NoResize">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button helpers:PixelIcon.Kind="{x:Static iconPacks:PackIconPixelartIconsKind.ViewportWide}"
                                                ToolTip="最大化/还原"
                                                Command="{x:Static helpers:WindowCommands.ToggleMaximize}"
                                                CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource WindowCaptionButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ResizeMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="NoResize">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                                            <Setter Property="helpers:PixelIcon.Kind" Value="{x:Static iconPacks:PackIconPixelartIconsKind.ViewportNarrow}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button helpers:PixelIcon.Kind="{x:Static iconPacks:PackIconPixelartIconsKind.Close}" Style="{StaticResource WindowCaptionButton}"
                                                ToolTip="关闭"
                                                Foreground="{StaticResource DangerBrush}"
                                                Command="{x:Static helpers:WindowCommands.Close}"
                                                CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <AdornerDecorator Grid.Row="1">
                                <ContentPresenter/>
                            </AdornerDecorator>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

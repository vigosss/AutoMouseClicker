<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:helpers="clr-namespace:Ming_AutoClicker.Helpers"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <sys:Double x:Key="PixelBodySize">12</sys:Double>
    <sys:Double x:Key="PixelTitleSize">24</sys:Double>
    <Thickness x:Key="PixelStroke">2</Thickness>
    <sys:Double x:Key="PixelGap">4</sys:Double>
    <sys:Double x:Key="PixelIconSize">24</sys:Double>
    <!-- Twelve-unit caption glyphs centered in the same 24-unit icon slot. -->
    <Geometry x:Key="PixelCaptionCloseGlyph">M 6,6 H 8 V 8 H 10 V 10 H 14 V 8 H 16 V 6 H 18 V 8 H 16 V 10 H 14 V 14 H 16 V 16 H 18 V 18 H 16 V 16 H 14 V 14 H 10 V 16 H 8 V 18 H 6 V 16 H 8 V 14 H 10 V 10 H 8 V 8 H 6 Z</Geometry>
    <Geometry x:Key="PixelCaptionMinimizeGlyph">M 6,12 H 18 V 14 H 6 Z</Geometry>
    <Style TargetType="helpers:PixelBorder">
        <Setter Property="StepSize" Value="{StaticResource PixelGap}"/>
    </Style>
    <!-- Preserve the original 24-unit coordinates instead of stretching each path's bounds. -->
    <Style TargetType="iconPacks:PackIconPixelartIcons">
        <Setter Property="Width" Value="{StaticResource PixelIconSize}"/>
        <Setter Property="Height" Value="{StaticResource PixelIconSize}"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="iconPacks:PackIconPixelartIcons">
                    <Canvas Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="{Binding Data, RelativeSource={RelativeSource TemplatedParent}}"
                              Fill="{TemplateBinding Foreground}" Stretch="None"
                              SnapsToDevicePixels="True" UseLayoutRounding="True"
                              RenderOptions.EdgeMode="Aliased"/>
                    </Canvas>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

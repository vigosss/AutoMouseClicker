<Window x:Class="Ming_AutoClicker.Views.Shared.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title=""
        Style="{StaticResource PixelWindow}"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Border Background="{StaticResource SurfaceBrush}"
            Margin="0"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- 标题栏 -->
                <RowDefinition Height="Auto"/>   <!-- 内容区 -->
                <RowDefinition Height="Auto"/>   <!-- 按钮区 -->
            </Grid.RowDefinitions>

            <!-- 标题栏（可拖动） -->
            <Border Grid.Row="0"
                    x:Name="TitleBar"
                    Background="{StaticResource PanelHeaderBrush}"
                    Padding="20,12"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 图标 -->
                    <iconPacks:PackIconPixelartIcons Grid.Column="0"
                                                          x:Name="IconGlyph"
                                                          Width="24" Height="24"
                                                          Foreground="{StaticResource TextOnPrimaryBrush}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,12,0"/>

                    <!-- 标题文字 -->
                    <TextBlock Grid.Column="1"
                               x:Name="TitleText"
                               FontSize="24"
                               Foreground="{StaticResource TextOnPrimaryBrush}"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <!-- 消息内容 -->
            <TextBlock Grid.Row="1"
                       x:Name="MessageText"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Padding="24,20"
                       LineHeight="20"/>

            <!-- 按钮区 -->
            <Border Grid.Row="2"
                    Background="{StaticResource StatusBarBrush}"
                    Padding="20,12"
                    BorderThickness="0,2,0,0"
                    BorderBrush="{StaticResource BorderBrush}">
                <StackPanel x:Name="ButtonPanel"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"/>
            </Border>
        </Grid>
    </Border>
</Window>

<Window x:Class="Ming_AutoClicker.Views.CoordinatePickWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource CoordinateTitle}"
        WindowStyle="None"
        Topmost="True"
        ResizeMode="NoResize"
        WindowState="Normal"
        Background="Black"
        ShowInTaskbar="False"
        Focusable="True"
        Cursor="Cross">

    <Canvas x:Name="MainCanvas">
        <!-- 屏幕截图背景 -->
        <Image x:Name="BackgroundImage" Stretch="Fill"/>

        <!-- 半透明遮罩 -->
        <Path x:Name="OverlayPath" Fill="#99080C18"/>

        <!-- 十字准星竖线 -->
        <Line x:Name="CrossV" Stroke="{StaticResource PrimaryBrush}" StrokeThickness="1" Opacity="0.9"
              X1="0" Y1="0" X2="0" Y2="0"/>
        <!-- 十字准星横线 -->
        <Line x:Name="CrossH" Stroke="{StaticResource PrimaryBrush}" StrokeThickness="1" Opacity="0.9"
              X1="0" Y1="0" X2="0" Y2="0"/>

        <!-- 坐标信息面板 -->
        <Border x:Name="InfoPanel"
                Background="#F20A1020"
                BorderBrush="{StaticResource PrimaryBrush}"
                BorderThickness="2"
                Padding="12,6"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="CoordText" Foreground="{StaticResource PrimaryBrush}" FontSize="14" FontFamily="{StaticResource PixelMonoFontFamily}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource CoordinateRelease}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- 提示文字 -->
        <TextBlock x:Name="TipText"
                   Text="{DynamicResource CoordinateInstruction}"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   FontSize="16"
                   Opacity="0.8"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
    </Canvas>
</Window>

<UserControl x:Class="Ming_AutoClicker.Views.AutoClick.AutoClickView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:helpers="clr-namespace:Ming_AutoClicker.Helpers">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 设置区域 -->
        <helpers:PixelBorder x:Name="AutoClickSettings" Grid.Row="0"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="2"
                Padding="16"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                IsEnabled="{Binding IsNotRunning}">
            <StackPanel>
                <!-- 点击类型 -->
                <TextBlock Text="{DynamicResource AutoClickType}" Style="{StaticResource SectionTitleText}" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <RadioButton Content="{DynamicResource AutoClickLeft}"
                                 Style="{StaticResource ModernRadioButton}"
                                 IsChecked="{Binding IsLeftButton, Mode=TwoWay}"
                                 GroupName="ClickButton"/>
                    <RadioButton Content="{DynamicResource AutoClickMiddle}"
                                 Style="{StaticResource ModernRadioButton}"
                                 IsChecked="{Binding IsMiddleButton, Mode=TwoWay}"
                                 GroupName="ClickButton"/>
                    <RadioButton Content="{DynamicResource AutoClickRight}"
                                 Style="{StaticResource ModernRadioButton}"
                                 IsChecked="{Binding IsRightButton, Mode=TwoWay}"
                                 GroupName="ClickButton"/>
                </StackPanel>

                <!-- 分隔线 -->
                <Border Background="{StaticResource BorderLightBrush}" Height="2" Margin="0,0,0,12"/>

                <!-- 点击间隔 -->
                <TextBlock Text="{DynamicResource AutoClickInterval}" Style="{StaticResource SectionTitleText}" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding IntervalText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}"
                             Height="36"
                             FontSize="12"
                             HorizontalContentAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="{DynamicResource AutoClickMilliseconds}"
                               Style="{StaticResource BodyText}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </Grid>
            </StackPanel>
        </helpers:PixelBorder>

        <helpers:PixelBorder x:Name="AutoClickFooter" Grid.Row="1" Height="Auto" Style="{StaticResource PageActionFooter}">
            <Border Height="40" Background="{StaticResource SurfaceBrush}" Padding="12,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <iconPacks:PackIconPixelartIcons Kind="Keyboard" Foreground="{StaticResource PrimaryBrush}"
                                                    Margin="0,0,8,0"/>
                    <TextBlock x:Name="AutoClickHotkeyHint" Text="{Binding HotkeyHintText}"
                               Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </helpers:PixelBorder>
    </Grid>
</UserControl>

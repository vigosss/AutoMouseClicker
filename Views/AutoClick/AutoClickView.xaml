<UserControl x:Class="Ming_AutoClicker.Views.AutoClick.AutoClickView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:Ming_AutoClicker.Helpers">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 设置区域 -->
        <helpers:PixelBorder Grid.Row="0"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="2"
                Padding="16"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                IsEnabled="{Binding IsNotRunning}">
            <StackPanel>
                <!-- 点击类型 -->
                <TextBlock Text="{DynamicResource AutoClickType}" Style="{StaticResource SectionTitleText}" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <RadioButton Content="{DynamicResource AutoClickLeft}"
                                 Style="{StaticResource ModernRadioButton}"
                                 IsChecked="{Binding IsLeftButton, Mode=TwoWay}"
                                 GroupName="ClickButton"/>
                    <RadioButton Content="{DynamicResource AutoClickMiddle}"
                                 Style="{StaticResource ModernRadioButton}"
                                 IsChecked="{Binding IsMiddleButton, Mode=TwoWay}"
                                 GroupName="ClickButton"/>
                    <RadioButton Content="{DynamicResource AutoClickRight}"
                                 Style="{StaticResource ModernRadioButton}"
                                 IsChecked="{Binding IsRightButton, Mode=TwoWay}"
                                 GroupName="ClickButton"/>
                </StackPanel>

                <!-- 分隔线 -->
                <Border Background="{StaticResource BorderLightBrush}" Height="2" Margin="0,0,0,12"/>

                <!-- 点击间隔 -->
                <TextBlock Text="{DynamicResource AutoClickInterval}" Style="{StaticResource SectionTitleText}" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding IntervalText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}"
                             Height="36"
                             FontSize="12"
                             HorizontalContentAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="{DynamicResource AutoClickMilliseconds}"
                               Style="{StaticResource BodyText}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </Grid>

                <!-- 分隔线 -->
                <Border Background="{StaticResource BorderLightBrush}" Height="2" Margin="0,0,0,12"/>

                <!-- 快捷键提示 -->
                <Border Background="{StaticResource StatusBarBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="2"
                        Padding="12,8"
                        HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource PrimaryDarkBrush}"
                                BorderThickness="2"
                                Padding="8,4"
                                Margin="0,0,8,0">
                            <TextBlock Text="{Binding DataContext.ActiveHotkeyDescription, RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontSize="12"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}">
                            <Run Text="{Binding HotkeyHintText, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </helpers:PixelBorder>

        <!-- 底部提示 -->
        <TextBlock Grid.Row="1"
                   Text="{Binding StatusText}"
                   Style="{StaticResource StatusText}"
                   Margin="0,8,0,0"/>
    </Grid>
</UserControl>

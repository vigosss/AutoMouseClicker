<Window x:Class="Ming_AutoClicker.Views.RenameRecordingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource RecordingRenameTitle}"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        PreviewKeyDown="OnWindowPreviewKeyDown">
    <Border Background="{StaticResource SurfaceBrush}"
            CornerRadius="12"
            Margin="12"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.15" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource PrimaryBrush}"
                    CornerRadius="12,12,0,0"
                    Padding="20,14"
                    MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✏" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource RecordingRenameTitle}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1" Margin="24,20">
                <TextBlock Text="{DynamicResource RecordingRenameHint}"
                           Style="{StaticResource CaptionText}"
                           Margin="0,0,0,10"/>
                <TextBox x:Name="NameInput"
                         Height="40"
                         Style="{StaticResource ModernTextBox}"/>
                <TextBlock x:Name="ValidationText"
                           MinHeight="18"
                           Margin="0,8,0,0"
                           FontSize="12"
                           Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Border Grid.Row="2"
                    Background="{StaticResource StatusBarBrush}"
                    CornerRadius="0,0,12,12"
                    Padding="20,14"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{StaticResource BorderBrush}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{DynamicResource CommonCancel}"
                            Style="{StaticResource BaseButton}"
                            MinWidth="80"
                            Margin="0,0,12,0"
                            Click="OnCancel"/>
                    <Button Content="{DynamicResource CommonConfirm}"
                            Style="{StaticResource PrimaryButton}"
                            MinWidth="80"
                            Click="OnConfirm"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

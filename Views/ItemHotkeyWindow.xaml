<Window x:Class="Ming_AutoClicker.Views.ItemHotkeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:helpers="clr-namespace:Ming_AutoClicker.Helpers"
        Title="{DynamicResource ItemHotkeyTitle}" Style="{StaticResource PixelWindow}"
        Width="420" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False" PreviewKeyDown="OnWindowPreviewKeyDown">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{DynamicResource ItemHotkeyHint}" Style="{StaticResource LabelText}" Margin="0,0,0,12"/>
            <TextBox x:Name="Input" Style="{StaticResource HotkeyCaptureTextBox}"
                     PreviewKeyDown="OnHotkeyPreviewKeyDown" GotKeyboardFocus="OnInputGotKeyboardFocus"
                     MouseLeftButtonDown="OnInputMouseLeftButtonDown"/>
            <TextBlock x:Name="Error" MinHeight="18" Margin="0,8,0,0" FontSize="12"
                       Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>
            <TextBlock Margin="0,8,0,0" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                       Text="{DynamicResource SettingsHotkeySupport}"/>
        </StackPanel>
        <Border Grid.Row="1" Height="2" Background="{StaticResource BorderBrush}" Margin="0,18,0,14"/>
        <Grid Grid.Row="2">
            <Button Content="{DynamicResource ItemHotkeyClear}" Style="{StaticResource DangerButton}"
                    helpers:PixelIcon.Kind="{x:Static iconPacks:PackIconPixelartIconsKind.Delete}"
                    MinWidth="90" HorizontalAlignment="Left" Click="OnClear"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource CommonCancel}" Style="{StaticResource GhostButton}"
                        helpers:PixelIcon.Kind="{x:Static iconPacks:PackIconPixelartIconsKind.Close}"
                        MinWidth="90" Margin="0,0,8,0" Click="OnCancel"/>
                <Button x:Name="ConfirmButton" Content="{DynamicResource CommonConfirm}" Style="{StaticResource PrimaryButton}"
                        helpers:PixelIcon.Kind="{x:Static iconPacks:PackIconPixelartIconsKind.Check}"
                        MinWidth="90" Click="OnConfirm"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

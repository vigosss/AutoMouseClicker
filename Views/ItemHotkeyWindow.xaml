<Window x:Class="Ming_AutoClicker.Views.ItemHotkeyWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{DynamicResource ItemHotkeyTitle}" Width="380" Height="210" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
 <StackPanel Margin="24"><TextBlock Text="{DynamicResource ItemHotkeyHint}" FontWeight="SemiBold"/><TextBox x:Name="Input" Height="38" Margin="0,12" PreviewKeyDown="OnKeyDown" IsReadOnly="True"/><TextBlock x:Name="Error" Foreground="{StaticResource DangerBrush}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="{DynamicResource ItemHotkeyClear}" Style="{StaticResource DangerButton}" Click="OnClear"/><Button Content="{DynamicResource CommonCancel}" Style="{StaticResource GhostButton}" Click="OnCancel" Margin="8,0"/><Button Content="{DynamicResource CommonConfirm}" Style="{StaticResource PrimaryButton}" Click="OnConfirm"/></StackPanel></StackPanel>
</Window>

<Window x:Class="Ming_AutoClicker.Views.OptimizeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{DynamicResource OptimizeTitle}" Width="760" Height="560" WindowStartupLocation="CenterOwner">
 <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal"><TextBlock Text="{DynamicResource OptimizeName}" VerticalAlignment="Center"/><TextBox x:Name="NameBox" Width="250" Margin="8,0"/><TextBlock x:Name="Summary" VerticalAlignment="Center"/></StackPanel>
  <DataGrid x:Name="Grid" Grid.Row="1" Margin="0,12" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridCheckBoxColumn Header="{DynamicResource OptimizeEnabled}" Binding="{Binding IsEnabled}"/><DataGridTextColumn Header="{DynamicResource OptimizeType}" Binding="{Binding Type}" IsReadOnly="True"/><DataGridTextColumn Header="{DynamicResource OptimizeDelay}" Binding="{Binding DelayBeforeMs}"/><DataGridTextColumn Header="{DynamicResource OptimizeInput}" Binding="{Binding KeyName}" IsReadOnly="True"/></DataGrid.Columns></DataGrid>
  <Grid Grid.Row="2"><StackPanel Orientation="Horizontal"><Button Content="{DynamicResource OptimizeRemoveWait}" Style="{StaticResource SmallButton}" Click="RemoveWait"/><Button Content="{DynamicResource OptimizeDisableMoves}" Style="{StaticResource SmallButton}" Margin="6,0" Click="RemoveMoves"/><Button Content="{DynamicResource OptimizeMergeMoves}" Style="{StaticResource SmallButton}" Click="MergeMoves"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{DynamicResource CommonCancel}" Style="{StaticResource GhostButton}" Click="Cancel"/><Button Content="{DynamicResource OptimizeSave}" Style="{StaticResource PrimaryButton}" Click="Save" Margin="8,0,0,0"/></StackPanel></Grid>
 </Grid>
</Window>

<Window x:Class="Ming_AutoClicker.Views.ImageMatching.MatchResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:Ming_AutoClicker.Helpers"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="{DynamicResource MatchTitle}" WindowStyle="None" Topmost="True"
        ResizeMode="NoResize" WindowState="Normal" WindowStartupLocation="Manual"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource PixelFontFamily}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        ShowInTaskbar="False" Focusable="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Ming-AutoClicker;component/Styles/ImageMatching.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="Button" BasedOn="{StaticResource BaseButton}">
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="Padding" Value="12,4"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid x:Name="Viewport" ClipToBounds="True">
        <Canvas x:Name="MainCanvas" IsHitTestVisible="False">
            <Image x:Name="BackgroundImage" Stretch="Fill"/>
            <Canvas x:Name="CandidateCanvas"/>
        </Canvas>
        <Canvas>
        <helpers:PixelBorder x:Name="InfoPanel" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource SuccessBrush}"
                BorderThickness="2" Padding="16" MaxWidth="460"
                HorizontalAlignment="Left" VerticalAlignment="Top">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <Button helpers:PixelIcon.Kind="{x:Static iconPacks:PackIconPixelartIconsKind.Close}" Click="CloseClick" DockPanel.Dock="Right"
                            Width="40" Height="36" MinHeight="0" Padding="0" Margin="16,0,0,0"
                            ToolTip="{DynamicResource MatchExit}"/>
                    <TextBlock x:Name="StatusTitle" FontSize="24"
                               Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
                <TextBlock x:Name="StatusDescription" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"
                           FontSize="12" Margin="0,0,0,12"/>
                <TextBlock Text="{DynamicResource MatchPreviewNoClick}" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <Button x:Name="StopTestButton" Content="{DynamicResource ImageStopTest}"
                        Click="StopTestClick" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                <WrapPanel x:Name="HelpActions" Margin="0,0,0,12">
                    <Button x:Name="ScopeHelpButton" Content="{DynamicResource MatchHelpScope}"
                            Click="ScopeHelpClick" Margin="0,0,8,8" Padding="8,4"/>
                    <Button x:Name="AlternateHelpButton" Content="{DynamicResource MatchHelpAlternate}"
                            Click="AlternateHelpClick" Margin="0,0,8,8" Padding="8,4"/>
                    <Button x:Name="RecaptureHelpButton" Content="{DynamicResource MatchHelpRecapture}"
                            Click="RecaptureHelpClick" Margin="0,0,0,8" Padding="8,4"/>
                </WrapPanel>
                <Expander x:Name="ResultDetails" Header="{DynamicResource MatchDetails}" Style="{StaticResource ImageMatchingExpander}" IsExpanded="False">
                    <Grid Margin="0,12,0,0">
                        <Grid.Resources>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            </Style>
                        </Grid.Resources>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{DynamicResource MatchClickPosition}" Margin="0,0,16,8"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtPosition" Foreground="White"/>
                        <TextBlock Grid.Row="1" Text="{DynamicResource MatchScore}" Margin="0,0,16,8"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtSimilarity" Foreground="White"/>
                        <TextBlock Grid.Row="2" Text="{DynamicResource MatchRegion}" Margin="0,0,16,8"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtRegion" Foreground="White"/>
                        <TextBlock Grid.Row="3" Text="{DynamicResource MatchThreshold}" Margin="0,0,16,8"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtThreshold" Foreground="White"/>
                        <TextBlock Grid.Row="4" Text="{DynamicResource MatchScale}" Margin="0,0,16,8"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TxtScale" Foreground="White"/>
                        <TextBlock Grid.Row="5" Text="{DynamicResource MatchMethod}" Margin="0,0,16,8"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" x:Name="TxtMethod" Foreground="White" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="6" Text="{DynamicResource MatchElapsed}" Margin="0,0,16,8"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" x:Name="TxtElapsed" Foreground="White"/>
                        <TextBlock Grid.Row="7" Text="{DynamicResource MatchSecondBest}" Margin="0,0,16,8"/>
                        <TextBlock Grid.Row="7" Grid.Column="1" x:Name="TxtSecondBest" Foreground="White"/>
                        <TextBlock Grid.Row="8" Text="{DynamicResource MatchTemplateLabel}" Margin="0,0,16,0"/>
                        <TextBlock Grid.Row="8" Grid.Column="1" x:Name="TxtTemplate" Foreground="White" TextWrapping="Wrap"/>
                    </Grid>
                </Expander>
            </StackPanel>
            </ScrollViewer>
        </helpers:PixelBorder>
        </Canvas>
        <helpers:PixelBorder x:Name="FooterPanel" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="2"
                Padding="20,12" Margin="24" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
            <TextBlock Text="{DynamicResource MatchExit}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
        </helpers:PixelBorder>
    </Grid>
</Window>

<UserControl x:Class="Ming_AutoClicker.Views.Macros.MacroListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Ming_AutoClicker.Models"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:helpers="clr-namespace:Ming_AutoClicker.Helpers">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 宏列表 -->
        <ListBox Grid.Row="0"
                 x:Name="MacroListBox"
                 ItemsSource="{Binding Macros}"
                 SelectedItem="{Binding SelectedMacro}"
                 IsEnabled="{Binding IsNotExecuting}"
                 Style="{StaticResource ModernListBox}">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource CardListBoxItem}"/>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:MacroProfile}">
                    <Grid Height="52">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 宏信息 -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="12"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="MacroMetadata" Style="{StaticResource CaptionText}"
                                       Margin="0,4,0,0" TextWrapping="Wrap">
                                <Run Text="{Binding Actions.Count, Mode=OneWay}"/>
                                <Run Text="{DynamicResource MacroActionCountSuffix}"/>
                                <Run Text=" · "/>
                                <Run x:Name="MacroRunCount" Text="{Binding RunCountText, Mode=OneWay}"/>
                                <Run Text=" · "/>
                                <Run Text="{Binding UpdatedAt, StringFormat='{}{0:MM-dd&#160;HH:mm}'}"/>
                            </TextBlock>
                        </StackPanel>

                        <!-- 操作按钮（仅选中时显示） -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Button Content="{DynamicResource MacroEdit}" Style="{StaticResource GhostButton}" Margin="0,0,4,0"
                                    helpers:PixelIcon.Kind="{x:Static iconPacks:PackIconPixelartIconsKind.Edit}"
                                    Click="OnEditClick" Tag="{Binding}"
                                    IsEnabled="{Binding DataContext.IsNotExecuting, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            <Button Content="{DynamicResource MacroItemHotkey}" Style="{StaticResource GhostButton}" Margin="0,0,4,0" Click="OnHotkeyClick"
                                    helpers:PixelIcon.Kind="{x:Static iconPacks:PackIconPixelartIconsKind.Keyboard}"/>
                            <Button Content="{DynamicResource MacroDuplicate}" Style="{StaticResource GhostButton}" Margin="0,0,4,0"
                                    helpers:PixelIcon.Kind="{x:Static iconPacks:PackIconPixelartIconsKind.Copy}"
                                    Command="{Binding DataContext.DuplicateMacroCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            <Button Content="{DynamicResource MacroDelete}" Style="{StaticResource DangerButton}"
                                    helpers:PixelIcon.Kind="{x:Static iconPacks:PackIconPixelartIconsKind.Trash}"
                                    Command="{Binding DataContext.DeleteMacroCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <helpers:PixelBorder x:Name="MacroFooter" Grid.Row="1" Style="{StaticResource PageActionFooter}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="32"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.ColumnSpan="3"
                        Content="{DynamicResource MacroCreate}"
                        helpers:PixelIcon.Kind="{x:Static iconPacks:PackIconPixelartIconsKind.AddBox}"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding CreateMacroCommand}"/>

                <TextBlock Grid.Row="2"
                           Text="{Binding MacroHotkeyHintText}"
                           Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button Grid.Row="2" Grid.Column="1"
                        Content="{DynamicResource MacroStart}"
                        helpers:PixelIcon.Kind="{x:Static iconPacks:PackIconPixelartIconsKind.Play}"
                        Style="{StaticResource SuccessButton}"
                        MinWidth="96" MinHeight="32" Padding="12,0" Margin="0,0,8,0"
                        Command="{Binding StartMacroCommand}"/>
                <Button Grid.Row="2" Grid.Column="2"
                        Content="{DynamicResource MacroStop}"
                        helpers:PixelIcon.Kind="{x:Static iconPacks:PackIconPixelartIconsKind.DebugStop}"
                        Style="{StaticResource DangerButton}"
                        MinWidth="96" MinHeight="32" Padding="12,0"
                        Command="{Binding StopMacroCommand}"/>
            </Grid>
        </helpers:PixelBorder>
    </Grid>
</UserControl>

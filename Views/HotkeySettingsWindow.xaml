<Window x:Class="Ming_AutoClicker.Views.HotkeySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快捷键设置"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">
    <Border Background="{StaticResource SurfaceBrush}"
            CornerRadius="12"
            Margin="12"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.15" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource PrimaryBrush}"
                    CornerRadius="12,12,0,0"
                    Padding="20,14"
                    MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⌨" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock Text="全局快捷键设置"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1" Margin="24,20">
                <TextBlock Text="开始 / 停止"
                           Style="{StaticResource SectionTitleText}"
                           Margin="0,0,0,8"/>
                <TextBlock Text="点击下方输入框，然后直接按下新的按键组合。"
                           Style="{StaticResource CaptionText}"
                           Margin="0,0,0,12"/>

                <TextBox x:Name="HotkeyInput"
                         Height="44"
                         IsReadOnly="True"
                         Style="{StaticResource ModernTextBox}"
                         FontSize="16"
                         FontWeight="SemiBold"
                         HorizontalContentAlignment="Center"
                         PreviewKeyDown="OnHotkeyPreviewKeyDown"
                         GotKeyboardFocus="OnInputGotKeyboardFocus"
                         MouseLeftButtonDown="OnInputMouseLeftButtonDown"/>

                <TextBlock x:Name="ValidationText"
                           MinHeight="18"
                           Margin="0,8,0,0"
                           FontSize="12"
                           Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap"/>

                <TextBlock Margin="0,8,0,0"
                           Style="{StaticResource CaptionText}"
                           TextWrapping="Wrap"
                           Text="支持 F1–F12，或 Ctrl / Alt / Shift + 字母、数字。字母和数字不能单独使用，以免打字时误触。"/>
            </StackPanel>

            <Border Grid.Row="2"
                    Background="{StaticResource StatusBarBrush}"
                    CornerRadius="0,0,12,12"
                    Padding="20,14"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{StaticResource BorderBrush}">
                <Grid>
                    <Button Content="恢复默认 F8"
                            Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Left"
                            Click="OnResetClick"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消"
                                Style="{StaticResource BaseButton}"
                                MinWidth="80"
                                Margin="0,0,12,0"
                                Click="OnCancelClick"/>
                        <Button x:Name="SaveButton"
                                Content="保存"
                                Style="{StaticResource PrimaryButton}"
                                MinWidth="80"
                                Click="OnSaveClick"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

<Window x:Class="Ming_AutoClicker.Views.HotkeySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:helpers="clr-namespace:Ming_AutoClicker.Helpers"
        Title="{DynamicResource SettingsTitle}"
        Style="{StaticResource PixelWindow}"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        PreviewKeyDown="OnWindowPreviewKeyDown">
    <Border Background="{StaticResource SurfaceBrush}"
            Margin="0"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource PrimaryBrush}"
                    Padding="20,14"
                    MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconPixelartIcons Kind="Sliders2" Width="18" Height="18"
                                                          Foreground="{StaticResource TextOnPrimaryBrush}"
                                                          Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource SettingsHeader}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextOnPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1" Margin="24,20">
                <TextBlock Text="{DynamicResource SettingsLanguage}"
                           Style="{StaticResource SectionTitleText}"
                           Margin="0,0,0,8"/>
                <ComboBox x:Name="LanguageComboBox"
                          Height="36"
                          Style="{StaticResource ModernComboBox}"
                          SelectionChanged="OnLanguageSelectionChanged">
                    <ComboBoxItem Content="{DynamicResource SettingsLanguageSystem}" Tag="System" Style="{StaticResource ModernComboBoxItem}"/>
                    <ComboBoxItem Content="{DynamicResource SettingsLanguageChinese}" Tag="SimplifiedChinese" Style="{StaticResource ModernComboBoxItem}"/>
                    <ComboBoxItem Content="{DynamicResource SettingsLanguageEnglish}" Tag="English" Style="{StaticResource ModernComboBoxItem}"/>
                </ComboBox>
                <TextBlock Text="{DynamicResource SettingsLanguageHint}"
                           Style="{StaticResource CaptionText}"
                           Margin="0,6,0,20"/>

                <TextBlock Text="{DynamicResource SettingsHotkey}"
                           Style="{StaticResource SectionTitleText}"
                           Margin="0,0,0,8"/>
                <TextBlock Text="{DynamicResource SettingsHotkeyHint}"
                           Style="{StaticResource CaptionText}"
                           Margin="0,0,0,12"/>

                <TextBox x:Name="HotkeyInput"
                         Height="44"
                         IsReadOnly="True"
                         Style="{StaticResource ModernTextBox}"
                         FontSize="16"
                         FontWeight="SemiBold"
                         HorizontalContentAlignment="Center"
                         PreviewKeyDown="OnHotkeyPreviewKeyDown"
                         GotKeyboardFocus="OnInputGotKeyboardFocus"
                         MouseLeftButtonDown="OnInputMouseLeftButtonDown"/>

                <TextBlock x:Name="ValidationText"
                           MinHeight="18"
                           Margin="0,8,0,0"
                           FontSize="12"
                           Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap"/>

                <TextBlock Margin="0,8,0,0"
                           Style="{StaticResource CaptionText}"
                           TextWrapping="Wrap"
                           Text="{DynamicResource SettingsHotkeySupport}"/>
            </StackPanel>

            <Border Grid.Row="2"
                    Background="{StaticResource StatusBarBrush}"
                    Padding="20,14"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{StaticResource BorderBrush}">
                <Grid>
                    <Button Content="{DynamicResource SettingsResetHotkey}"
                            helpers:PixelIcon.Kind="{x:Static iconPacks:PackIconPixelartIconsKind.Reload}"
                            Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Left"
                            Click="OnResetClick"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{DynamicResource CommonCancel}"
                                helpers:PixelIcon.Kind="{x:Static iconPacks:PackIconPixelartIconsKind.Close}"
                                Style="{StaticResource BaseButton}"
                                MinWidth="80"
                                Margin="0,0,12,0"
                                Click="OnCancelClick"/>
                        <Button x:Name="SaveButton"
                                Content="{DynamicResource CommonSave}"
                                helpers:PixelIcon.Kind="{x:Static iconPacks:PackIconPixelartIconsKind.Save}"
                                Style="{StaticResource PrimaryButton}"
                                MinWidth="80"
                                Click="OnSaveClick"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
